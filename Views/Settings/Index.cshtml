@model SettingsViewModel
@{
    ViewData["Title"] = "設定";
}

<div class="container py-4" style="max-width:900px">
    <h4 class="mb-4"><i class="bi bi-gear me-2"></i>設定</h4>

    <ul class="nav nav-tabs mb-4" id="settingsTabs">
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "datatypes" ? "active" : "")"
               href="@Url.Action("Index", new { tab = "datatypes" })">資料類別</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "push" ? "active" : "")"
               href="@Url.Action("Index", new { tab = "push" })">推送平台設定</a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(Model.ActiveTab == "topics" ? "active" : "")"
               href="@Url.Action("Index", new { tab = "topics" })">資訊種類</a>
        </li>
    </ul>

    @if (Model.ActiveTab == "push")
    {
        string S(string key) => Model.PushSettings.GetValueOrDefault(key, "");

        <form asp-action="SavePushSettings" method="post">
            @Html.AntiForgeryToken()

            <div class="card mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-journal-text me-1"></i> Notion 設定
                </div>
                <div class="card-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <strong>設定步驟：</strong>
                        1. 前往 <a href="https://www.notion.so/my-integrations" target="_blank">notion.so/my-integrations</a> 建立 Integration，複製 Token。
                        2. 在 Notion 建立 Database，共用給此 Integration。
                        3. 確保 Database 有以下欄位：<code>Name</code>（title）、<code>Source</code>（url）、
                           <code>DataTypes</code>/<code>Topics</code>/<code>Tags</code>（multi_select）、
                           <code>Author</code>/<code>SourceRef</code>（text）、<code>Published</code>（date）。
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API Token（Internal Integration Token）</label>
                        <input type="password" class="form-control" name="notion.api_token"
                               value="@S("notion.api_token")" placeholder="secret_xxx…" autocomplete="off" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Database ID</label>
                        <input type="text" class="form-control" name="notion.database_id"
                               value="@S("notion.database_id")"
                               placeholder="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" />
                        <div class="form-text">從 Notion Database 頁面 URL 中取得，32 位英數字串。</div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header fw-semibold">
                    <i class="bi bi-envelope me-1"></i> Email（SMTP）設定
                </div>
                <div class="card-body">
                    <div class="alert alert-info py-2 small mb-3">
                        <strong>Gmail 使用方式：</strong>
                        啟用兩步驟驗證 →
                        前往「<a href="https://myaccount.google.com/apppasswords" target="_blank">應用程式密碼</a>」
                        產生 16 碼密碼 → 填入下方「密碼」欄位（不是 Gmail 登入密碼）。
                    </div>
                    <div class="row">
                        <div class="col-md-8 mb-3">
                            <label class="form-label">SMTP 主機</label>
                            <input type="text" class="form-control" name="email.smtp_host"
                                   value="@S("email.smtp_host")" placeholder="smtp.gmail.com" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">SMTP 連接埠</label>
                            <input type="number" class="form-control" name="email.smtp_port"
                                   value="@S("email.smtp_port")" placeholder="587" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">帳號（Gmail 地址）</label>
                            <input type="email" class="form-control" name="email.username"
                                   value="@S("email.username")" placeholder="you@gmail.com" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">密碼（應用程式密碼）</label>
                            <input type="password" class="form-control" name="email.password"
                                   value="@S("email.password")" autocomplete="off" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">寄件人地址（選填，預設同帳號）</label>
                            <input type="email" class="form-control" name="email.from_address"
                                   value="@S("email.from_address")" />
                        </div>
                        <div class="col-md-6 mb-0">
                            <label class="form-label">收件人（多個用逗號分隔）</label>
                            <input type="text" class="form-control" name="email.to_addresses"
                                   value="@S("email.to_addresses")" placeholder="a@example.com, b@example.com" />
                        </div>
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>儲存設定
            </button>
        </form>
    }

    @if (Model.ActiveTab == "datatypes")
    {
        <div class="card">
            <div class="card-header fw-semibold d-flex justify-content-between align-items-center">
                資料類別管理
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>名稱</th>
                            <th style="width:160px">狀態</th>
                            <th style="width:120px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var dt in Model.DataTypes)
                        {
                            <tr class="@(dt.IsActive ? "" : "text-muted")">
                                <td>
                                    <form asp-action="EditDataType" method="post" class="d-flex gap-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dt.Id" />
                                        <input type="text" class="form-control form-control-sm" name="name"
                                               value="@dt.Name" style="max-width:200px" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">更新</button>
                                    </form>
                                </td>
                                <td>
                                    <span class="badge @(dt.IsActive ? "bg-success" : "bg-secondary")">
                                        @(dt.IsActive ? "啟用" : "停用")
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="ToggleDataType" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@dt.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            @(dt.IsActive ? "停用" : "啟用")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <form asp-action="AddDataType" method="post" class="d-flex gap-2">
                    @Html.AntiForgeryToken()
                    <input type="text" class="form-control form-control-sm" name="name"
                           placeholder="新類別名稱…" style="max-width:200px" required />
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg"></i> 新增
                    </button>
                </form>
            </div>
        </div>
    }

    @if (Model.ActiveTab == "topics")
    {
        <div class="card">
            <div class="card-header fw-semibold">資訊種類管理</div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>名稱（縮排代表層級）</th>
                            <th style="width:120px">上層主題</th>
                            <th style="width:100px">狀態</th>
                            <th style="width:120px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var t in Model.Topics)
                        {
                            <tr class="@(t.IsActive ? "" : "text-muted")">
                                <td>
                                    <form asp-action="EditTopic" method="post" class="d-flex gap-2 align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <span style="padding-left:@(t.Level * 20)px; color:#adb5bd">
                                            @(t.Level > 0 ? "└─ " : "")
                                        </span>
                                        <input type="text" class="form-control form-control-sm" name="name"
                                               value="@t.Name" style="max-width:180px" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary">更新</button>
                                    </form>
                                </td>
                                <td class="small text-muted align-middle">@t.ParentName</td>
                                <td class="align-middle">
                                    <span class="badge @(t.IsActive ? "bg-success" : "bg-secondary")">
                                        @(t.IsActive ? "啟用" : "停用")
                                    </span>
                                </td>
                                <td class="align-middle">
                                    <form asp-action="ToggleTopic" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@t.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">
                                            @(t.IsActive ? "停用" : "啟用")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer">
                <form asp-action="AddTopic" method="post" class="d-flex gap-2 align-items-end flex-wrap">
                    @Html.AntiForgeryToken()
                    <div>
                        <label class="form-label small mb-1">主題名稱</label>
                        <input type="text" class="form-control form-control-sm" name="name"
                               placeholder="新主題名稱…" required style="width:180px" />
                    </div>
                    <div>
                        <label class="form-label small mb-1">上層主題（選填）</label>
                        <select class="form-select form-select-sm" name="parentId" style="width:160px">
                            <option value="0">（根目錄）</option>
                            @foreach (var dt in Model.Topics.Where(t => t.IsActive))
                            {
                                <option value="@dt.Id">
                                    @(new string('　', dt.Level))@dt.Name
                                </option>
                            }
                        </select>
                    </div>
                    <button type="submit" class="btn btn-sm btn-primary">
                        <i class="bi bi-plus-lg"></i> 新增
                    </button>
                </form>
            </div>
        </div>
    }
</div>
