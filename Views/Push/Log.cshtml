@model PushSchedule
@{
    ViewData["Title"] = $"{Model.Name} 執行記錄";
}

<div class="container py-4" style="max-width:900px">
    <div class="d-flex align-items-center mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary me-3">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h4 class="mb-0">@Model.Name</h4>
            <small class="text-muted">執行記錄（最近 50 筆）</small>
        </div>
    </div>

    @if (!Model.Logs.Any())
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-clock-history fs-1 d-block mb-2"></i>
            <p>尚無執行記錄</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>執行時間</th>
                        <th>結果</th>
                        <th>推送筆數</th>
                        <th>訊息</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model.Logs)
                    {
                        <tr>
                            <td class="text-nowrap">@log.RunAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
                            <td>
                                @if (log.Status == "success")
                                {
                                    <span class="badge bg-success">成功</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">失敗</span>
                                }
                            </td>
                            <td>@log.ItemCount</td>
                            <td class="small text-muted">@log.Message</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
