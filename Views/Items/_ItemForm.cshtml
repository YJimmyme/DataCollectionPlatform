@model ItemFormViewModel

<div class="card mb-3">
    <div class="card-header fw-semibold">基本資訊</div>
    <div class="card-body">

        @* URL 快速填入 *@
        <div class="mb-3">
            <label class="form-label small text-muted">快速填入網址（自動擷取標題）</label>
            <div class="input-group">
                <input type="url" class="form-control" id="autoFillUrl" placeholder="貼上網址按 Enter…" />
                <button type="button" class="btn btn-outline-secondary" id="btnFetchUrl">
                    <i class="bi bi-magic"></i> 自動填入
                </button>
            </div>
            <div id="fetchStatus" class="form-text"></div>
        </div>

        <div class="mb-3">
            <label asp-for="Title" class="form-label"></label>
            <input asp-for="Title" class="form-control" />
            <span asp-validation-for="Title" class="text-danger small"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Summary" class="form-label"></label>
            <textarea asp-for="Summary" class="form-control" rows="3"></textarea>
        </div>

        <div class="row">
            <div class="col-md-6 mb-3">
                <label asp-for="Author" class="form-label"></label>
                <input asp-for="Author" class="form-control" />
            </div>
            <div class="col-md-6 mb-3">
                <label asp-for="PublishedAt" class="form-label"></label>
                <input asp-for="PublishedAt" class="form-control" type="date" />
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-semibold">
        來源 <span class="text-danger">*</span>
        <small class="text-muted fw-normal ms-2">（網址或出處說明至少填一項）</small>
    </div>
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="SourceUrl" class="form-label"></label>
            <input asp-for="SourceUrl" class="form-control" id="sourceUrlInput" type="url" />
            <span asp-validation-for="SourceUrl" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="SourceRef" class="form-label"></label>
            <input asp-for="SourceRef" class="form-control" placeholder="例：IEEE Transactions on Robotics, Vol.40" />
        </div>
        <div class="mb-3">
            <label asp-for="SourcePage" class="form-label"></label>
            <input asp-for="SourcePage" class="form-control" placeholder="例：p.123-135 或 Chapter 5" />
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-semibold">
        資料類別 <span class="text-danger">*</span>
        <span asp-validation-for="SelectedDataTypeIds" class="text-danger small ms-2"></span>
    </div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-3">
            @foreach (var dt in Model.AllDataTypes)
            {
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="SelectedDataTypeIds" value="@dt.Id"
                           id="fdt_@dt.Id"
                           @(Model.SelectedDataTypeIds.Contains(dt.Id) ? "checked" : "") />
                    <label class="form-check-label" for="fdt_@dt.Id">@dt.Name</label>
                </div>
            }
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-semibold">
        資訊種類 <span class="text-danger">*</span>
        <span asp-validation-for="SelectedTopicIds" class="text-danger small ms-2"></span>
    </div>
    <div class="card-body">
        <div class="row">
            @foreach (var node in Model.TopicTree)
            {
                <div class="col-md-4">
                    <div class="form-check" style="padding-left:@(node.Level * 16 + 24)px">
                        <input class="form-check-input" type="checkbox"
                               name="SelectedTopicIds" value="@node.Id"
                               id="ftopic_@node.Id"
                               @(Model.SelectedTopicIds.Contains(node.Id) ? "checked" : "") />
                        <label class="form-check-label @(node.Level == 0 ? "fw-semibold" : "")"
                               for="ftopic_@node.Id">@node.Name</label>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header fw-semibold">標籤 / 備註</div>
    <div class="card-body">
        <div class="mb-3">
            <label asp-for="Tags" class="form-label"></label>
            <input asp-for="Tags" class="form-control" placeholder="用逗號分隔，例：關鍵字一, 關鍵字二" />
        </div>
        <div class="mb-0">
            <label asp-for="Notes" class="form-label"></label>
            <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
        </div>
    </div>
</div>
